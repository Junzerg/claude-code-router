# Claude Code Router 服务器部署环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 基础配置 ====================
# 是否启用日志
LOG=true

# 日志级别 (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# 服务端口
PORT=3456

# API 密钥（用于鉴权，建议使用强随机字符串）
APIKEY=your-secure-random-api-key-here

# API 超时时间（毫秒）
API_TIMEOUT_MS=600000

# 代理配置（如果需要）
# PROXY_URL=http://proxy.example.com:8080
PROXY_URL=

# ==================== 运行模式 ====================
# 非交互模式（用于生产环境/CICD）
NON_INTERACTIVE_MODE=true

# ==================== VolcEngine 配置 ====================
# VolcEngine API 密钥
VOLCENGINE_API_KEY=your-volcengine-api-key-here

# VolcEngine 模型名称
VOLCENGINE_MODEL=deepseek-v3-2-251201

# ==================== Pool 配置 ====================
# 是否启用账号池
POOL_ENABLED=true

# 默认并发数
POOL_MAX_CONCURRENCY=3

# 缓冲比例（0.1 表示保留10%额度作为缓冲）
POOL_BUFFER_RATIO=0.1

# 是否启用会话绑定
POOL_SESSION_BINDING=true

# 会话绑定过期时间（分钟）
POOL_SESSION_TTL=60

# 账号受限时是否中断绑定
POOL_BREAK_ON_LIMITED=true

# 最大重试次数
POOL_MAX_RETRIES=3

# 重试延迟（毫秒）
POOL_RETRY_DELAY=1000

# 是否启用使用量同步
POOL_USAGE_SYNC=true

# 同步间隔（分钟）
POOL_SYNC_INTERVAL=5

# ==================== Docker 配置 ====================
# Docker 容器名称
CONTAINER_NAME=claude-code-router

# Docker 网络名称
NETWORK_NAME=claude-network

# ==================== 日志配置 ====================
# 日志文件路径
LOG_FILE=/var/log/claude-router/app.log

# 日志轮转大小
LOG_MAX_SIZE=100m

# 日志保留天数
LOG_MAX_DAYS=30
